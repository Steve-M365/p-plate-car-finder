# ---------------------------------------------------------------------------
# P-Plate Car Finder - example environment file
# Copy to `.env` and edit. Command: cp .env.example .env
# ---------------------------------------------------------------------------

# Database. SQLite for local dev. For PostgreSQL swap to:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pplate
DATABASE_URL=sqlite:///./pplate.db

# Create tables on startup even if Alembic has not been run (handy for local dev).
AUTO_CREATE_TABLES=true

# --- Victorian P-plate rule thresholds (see pplate/services/p_plate_compliance.py)
# Current Victorian rule: power-to-mass ratio must not exceed 130 kW/tonne (tare mass).
PPLATE_POWER_TO_MASS_LIMIT=130.0
# Ratios between the lower band and the limit are reported as "unknown / verify"
# because official calculations use tare mass (lighter than the kerb weight we hold).
PPLATE_BORDERLINE_LOWER=120.0
# Legacy absolute power cap. Victoria no longer uses one; leave blank/None to disable.
# PPLATE_ABSOLUTE_POWER_LIMIT_KW=149

# --- Web search for recommendations ----------------------------------------
# Optional. If set, the Tavily search API is used. Otherwise the app falls back
# to a bundled static knowledge base + DuckDuckGo HTML search (best effort).
TAVILY_API_KEY=
SEARCH_USER_AGENT=PPlateCarFinder/0.1 (+local educational use)
SEARCH_RATE_LIMIT_SECONDS=2.0
SEARCH_CACHE_TTL_SECONDS=86400
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20

# --- Listing fetch ----------------------------------------------------------
# "auto" = try real providers (robots.txt permitting), fall back to CSV/mock.
# Other values: "mock", "csv", "carsales"
LISTING_PROVIDER=auto
LISTINGS_CSV_PATH=./data/listings.csv
LISTING_RATE_LIMIT_SECONDS=3.0
LISTING_CACHE_TTL_SECONDS=3600
# Where to store the on-disk HTTP cache and request log.
CACHE_DIR=./.cache
LOG_LEVEL=INFO
